#!/bin/sh
# 阻止手滑直接推 main。
#
# 規則：推上 main 嘅 commit 必須已經存在於 dev（即係你係「合併 dev -> main」之後推）。
#      喺 main 上直接改嘢、或者 dev 未合併，都會被擋。
# 例外：ALLOW_MAIN_PUSH=1 git push
#
# 安裝：powershell -ExecutionPolicy Bypass -File tools/install-hooks.ps1

if [ "$ALLOW_MAIN_PUSH" = "1" ]; then
	exit 0
fi

protected="refs/heads/main"
zero="0000000000000000000000000000000000000000"
blocked=0

while read local_ref local_sha remote_ref remote_sha; do
	[ "$remote_ref" = "$protected" ] || continue

	if [ "$local_sha" = "$zero" ]; then
		echo "[pre-push] 唔准刪除 main。" >&2
		blocked=1
		continue
	fi

	if ! git rev-parse --verify --quiet refs/heads/dev >/dev/null 2>&1; then
		echo "[pre-push] 搵唔到 dev 分支，無法確認 main 係合併結果，所以擋。" >&2
		blocked=1
		continue
	fi

	if git merge-base --is-ancestor "$local_sha" refs/heads/dev 2>/dev/null; then
		continue
	fi

	echo "[pre-push] 阻止：要推上 main 嘅 commit ($local_sha) 唔喺 dev 入面。" >&2
	echo "           即係你喺 main 上直接改咗嘢，或者 dev 仲未合併。" >&2
	blocked=1
done

if [ "$blocked" = "1" ]; then
	echo "" >&2
	echo "正確流程：" >&2
	echo "  1) git checkout dev; git commit -am '...'; git push" >&2
	echo "  2) git checkout main; git merge dev; git push origin main" >&2
	echo "真要硬推（PowerShell）：\$env:ALLOW_MAIN_PUSH=1; git push" >&2
	exit 1
fi

exit 0